{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter frontend build && pnpm --filter api build",
  "outputDirectory": "apps/web/dist",
  "builds": [
    {
      "src": "apps/web/dist/**",
      "use": "@vercel/static"
    },
    {
      "src": "apps/api/src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "apps/api/src/main.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
