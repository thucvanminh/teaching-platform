{
  "version": 2,
  "installCommand": "pnpm install && pnpm --filter frontend build && pnpm --filter api build",
  "outputDirectory": "apps/web/dist",
  "builds": [
    {
      "src": "apps/api/src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "apps/api/src/main.ts"
    }
  ]
}
